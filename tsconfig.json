{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "design/**", "coverage", "playwright-report", "test-results", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"noUncheckedIndexedAccess": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	}
}

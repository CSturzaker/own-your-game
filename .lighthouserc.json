						"first-contentful-paint": [
							"error",
							{ "maxNumericValue": 1000, "aggregationMethod": "median-run" }
						],
						"largest-contentful-paint": [
							"error",
							{ "maxNumericValue": 1800, "aggregationMethod": "median-run" }
						],
						"total-blocking-time": [
							"error",
							{ "maxNumericValue": 150, "aggregationMethod": "median-run" }
						],
						"cumulative-layout-shift": [
							"error",
							{ "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
						]
					}
				},
				{
					"matchingUrlPattern": "localhost:4321/squad$",

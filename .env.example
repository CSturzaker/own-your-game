# ============================================================
# Own Your Game — environment template
#
# Copy to `.env.local` for local development. Do not commit real
# values. Cloudflare-set secrets (R2 access keys, Stream signing
# keys, etc.) belong in the Cloudflare dashboard, not here.
# ============================================================

# ------------------------------------------------------------
# Portraits
# ------------------------------------------------------------
# Public base URL for portrait images served from Cloudflare R2 via
# Cloudflare Image Resizing. The portrait URL helper appends the
# filename + a `?width=…&format=webp` query. Leave unset locally to
# fall back to the silhouette renderer (DEV-26).
PUBLIC_PORTRAIT_BASE_URL=

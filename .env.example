# ============================================================
# Own Your Game — environment template
#
# Copy to `.env.local` for local development. Do not commit real
# values. Cloudflare-set secrets (R2 access keys, Stream signing
# keys, etc.) belong in the Cloudflare dashboard, not here.
# ============================================================

# ------------------------------------------------------------
# Portraits (Cloudflare Images)
# ------------------------------------------------------------
# The Cloudflare Images account hash — the segment after
# `imagedelivery.net/` in delivery URLs (Images → Settings in the
# dashboard). Public because the delivery URL ships to browsers. The
# portrait URL helper builds flexible-variant URLs
# (`imagedelivery.net/{hash}/{imageId}/{transform}`) with face-detection
# cropping. Leave unset locally to fall back to the silhouette renderer
# (DEV-26). See docs/ops/portraits.md.
PUBLIC_CF_IMAGES_ACCOUNT_HASH=

# ------------------------------------------------------------
# Video (Cloudflare Stream)
# ------------------------------------------------------------
# The `customer-{subdomain}` portion of the Cloudflare Stream iframe URL
# (e.g. `abc123def` → customer-abc123def.cloudflarestream.com). Public
# because the iframe URL is served to browsers. Consumed by the player
# card's Stream iframe (DEV-46); scaffolded in DEV-43. Leave unset until
# Cloudflare is provisioned — the video pane stays a stub, and any code
# reaching for the value throws a loud error (src/lib/stream.ts).
PUBLIC_STREAM_CUSTOMER_SUBDOMAIN=

# The Stream UID of the home-page campaign montage film (DEV-124) — same
# Stream account as above, so no second subdomain var. Leave unset until
# the montage asset is produced: the film poster renders regardless and
# pressing play shows the "video unavailable" state. Never commit or set
# a placeholder UID.
PUBLIC_STREAM_MONTAGE_UID=

# ------------------------------------------------------------
# Analytics (Cloudflare Web Analytics, DEV-125)
# ------------------------------------------------------------
# The Web Analytics site token, from the dashboard's JS snippet (Web
# Analytics → the site → manage snippet). Public because it ships in the
# page HTML's data-cf-beacon attribute — not a secret. The beacon is
# emitted only when this is set: set it ONLY in the Cloudflare Pages
# Production environment, and leave it unset locally, in Preview, and in
# CI, so non-production traffic stays out of the analytics data.
PUBLIC_CF_BEACON_TOKEN=

# ------------------------------------------------------------
# Voices pipeline (scripts/fetch-voices.ts, DEV-31)
# ------------------------------------------------------------
# Published-to-web CSV export URL for the campaign team's voices
# sheet. Set in GitHub Actions for production runs; set locally if
# you want to live-test against the real sheet. The URL itself is
# the only auth — the sheet is published "Anyone with the link".
# See docs/ops/sheet-schema.md for the auth model rationale.
VOICES_SHEET_CSV_URL=

# Slack incoming webhook for pipeline rejection notifications.
# Optional locally — when unset, validation errors print to stderr
# instead. Required in CI; lives in GitHub Actions secrets.
SLACK_PIPELINE_WEBHOOK_URL=

# Output path for the generated voices.json. Defaults to
# content/voices.json (matching the loader path used by DEV-34).
# Override if you want to write to a temp file during dev.
OUTPUT_PATH=

# ------------------------------------------------------------
# Intake ingest tool (scripts/ingest/build-voices.ts, DEV-104)
# ------------------------------------------------------------
# Standalone, run-by-hand ops tool only — NOT CI, NOT the 2-hourly
# pipeline. Needed only for `--apply` (the default dry-run needs none of
# these). See scripts/ingest/README.md.
#
# Cloudflare account id + an API token scoped to Stream Edit + Images
# Edit. The token is a real secret — keep it in your shell or .env.local
# (gitignored) or the team password manager, never in the repo.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Path to the Google service-account JSON. The intake Drive folder must
# be shared (reader) with the service account's email. Read automatically
# by the googleapis client.
GOOGLE_APPLICATION_CREDENTIALS=

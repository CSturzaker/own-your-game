---
import { makeT } from "~/i18n/astro";
import { formatVoiceCount } from "~/lib/header";

interface Props {
	/** Total voices to display. Static at build time today; the
	 * aria-live treatment is in place for the live-counting epic. */
	count: number;
	/** Total countries represented — the second figure in the pill. */
	countryCount: number;
	/** Extra classes to merge onto the wrapper. */
	class?: string;
}

const { count, countryCount, class: extraClass } = Astro.props;
const { t } = makeT(Astro.currentLocale);
// "{voices} voices · {countries} countries" (DEV-119) — the pill keeps the
// full picture (raw reach + country spread); the home hero card leads on
// countries alone. Both figures formatted with grouping separators.
const counterText = t("header.counter", {
	voices: formatVoiceCount(count),
	countries: formatVoiceCount(countryCount),
});
---

<div
	class:list={[
		"font-display border-rule bg-paper text-ink rounded-pill tracking-04 inline-flex items-center border font-semibold",
		"text-kicker lg:text-caption gap-1.5 px-2.5 py-1 lg:gap-2.5 lg:px-3.5 lg:py-1.5",
		extraClass,
	]}
	aria-live="polite"
	aria-atomic="true"
>
	<span data-pulse class="bg-brand-orange rounded-pill block size-2" aria-hidden="true"></span>
	<span class="tabular-nums">{counterText}</span>
</div>

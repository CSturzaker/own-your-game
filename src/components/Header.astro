---
import VoiceCounter from "~/components/VoiceCounter.astro";
import Wordmark from "~/components/Wordmark.astro";
import { makeT } from "~/i18n/astro";
import { isRtl, LOCALES } from "~/i18n/config";
import { localiseUrl } from "~/i18n/localise-url";
import { buildMobileNavStrings } from "~/i18n/mobile-nav-strings";
import { MobileNav } from "~/islands/MobileNav";
import { CAMPAIGN_SHARE_URL, NAV_ITEMS, type ActiveNav } from "~/lib/header";

interface Props {
	/** Which nav item is current — drives the active highlight. */
	active?: ActiveNav;
	/** Voices count for the counter pill. */
	count: number;
	/**
	 * Render the sticky/blurred look from the first paint. Normally
	 * the inline script below flips this once scroll passes a few px;
	 * the prop is useful for previewing the sticky state in demos
	 * and for the squad/letter pages that ship with the sticky look
	 * locked from the top.
	 */
	sticky?: boolean;
}

const { active, count, sticky = false } = Astro.props;
const { t, locale } = makeT(Astro.currentLocale);

// Mobile nav drawer (DEV-103). Islands can't call `t()` (it bundles every
// dictionary), so resolve strings, locale-aware nav hrefs, and the language
// list here and thread them in. The language links carry the SSR path only
// (no live query — the footer switcher remains the query-preserving path).
const dir = isRtl(locale) ? "rtl" : "ltr";
const currentPath = Astro.url.pathname;
const mobileNavStrings = buildMobileNavStrings(t);
const mobileNavLinks = NAV_ITEMS.map((item) => ({
	id: item.id,
	href: localiseUrl(item.href, locale),
	label: t(`header.nav.${item.id}`),
	active: active === item.id,
}));
const mobileNavLanguages = LOCALES.map((code) => ({
	code,
	href: localiseUrl(currentPath, code),
	label: t(`languages.${code}`),
	current: code === locale,
}));
---

<header
	data-sticky-trigger
	data-sticky={sticky ? "" : undefined}
	class:list={[
		"sticky top-0 z-10",
		"flex items-center gap-3 px-4 lg:gap-7 lg:px-10",
		"h-14 lg:h-18",
		"transition-[background-color,backdrop-filter,box-shadow,height] duration-200",
		"data-sticky:border-rule data-sticky:bg-paper/95 data-sticky:border-b data-sticky:backdrop-blur-sm",
		"data-sticky:shadow-sticky-header data-sticky:lg:h-15",
	]}
>
	<Wordmark size="header" />

	<nav aria-label={t("header.navAriaLabel")} class="ms-2 hidden gap-7 lg:flex">
		{
			NAV_ITEMS.map((item) => {
				const isActive = active === item.id;
				return (
					<a
						href={localiseUrl(item.href, locale)}
						aria-current={isActive ? "page" : undefined}
						class:list={[
							"text-small relative py-1.5 font-medium",
							isActive
								? "text-ink after:bg-brand-orange font-semibold after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:content-['']"
								: "text-ink-2 hover:text-ink",
						]}
					>
						{t(`header.nav.${item.id}`)}
					</a>
				);
			})
		}
	</nav>

	<div class="ms-auto flex items-center gap-3">
		<VoiceCounter count={count} />

		<button
			type="button"
			data-header-share
			data-share-url={CAMPAIGN_SHARE_URL}
			data-copied={t("letter.share.copied")}
			data-copied-status={t("letter.share.copiedStatus")}
			data-copy-error={t("letter.share.copyError")}
			class:list={[
				"hidden items-center gap-1.5 lg:inline-flex",
				"border-ink bg-ink text-paper text-caption rounded-pill min-h-9 border px-4 py-2 font-semibold",
			]}
		>
			<span data-share-label>{t("header.share")}</span>
			<span aria-hidden="true">↗</span>
		</button>
		{/* SR status for the copy-link fallback; paired to the button above by the script. */}
		<span data-header-share-status role="status" aria-live="polite" class="sr-only"></span>

		<MobileNav
			client:idle
			links={mobileNavLinks}
			languages={mobileNavLanguages}
			strings={mobileNavStrings}
			dir={dir}
			shareUrl={CAMPAIGN_SHARE_URL}
		/>
	</div>
</header>

<script>
	// Toggle `data-sticky` once the user has scrolled a handful of
	// pixels. position: sticky already keeps the header pinned; this
	// only governs the visual transition to the blurred / compact
	// state so the look matches the prototype.
	const header = document.querySelector<HTMLElement>("[data-sticky-trigger]");
	if (header) {
		const threshold = 8;
		const update = () => {
			if (window.scrollY > threshold) header.setAttribute("data-sticky", "");
			else header.removeAttribute("data-sticky");
		};
		update();
		window.addEventListener("scroll", update, { passive: true });
	}
</script>

<script>
	// Wire the desktop Share CTA: native share sheet where available
	// (`navigator.share`), clipboard copy-link fallback otherwise — the
	// same approach as the letter's `ShareSection`. `querySelectorAll`
	// because a page can render more than one Header (e.g. the demo's
	// sticky-preview instance), each carrying its own URL + strings.
	for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-header-share]")) {
		const url = btn.dataset.shareUrl ?? window.location.href;
		const copiedText = btn.dataset.copied ?? "Copied!";
		const copiedStatusText = btn.dataset.copiedStatus ?? "Link copied to clipboard";
		const copyErrorText =
			btn.dataset.copyError ?? "Couldn't copy — your browser blocked clipboard access";
		const label = btn.querySelector<HTMLElement>("[data-share-label]");
		const status = btn.parentElement?.querySelector<HTMLElement>("[data-header-share-status]");

		btn.addEventListener("click", async () => {
			if (typeof navigator.share === "function") {
				try {
					await navigator.share({ title: document.title, url });
				} catch {
					/* user dismissed the share sheet, or the payload was rejected */
				}
				return;
			}
			try {
				await navigator.clipboard.writeText(url);
				if (status) status.textContent = copiedStatusText;
				if (label) {
					const original = label.textContent;
					label.textContent = copiedText;
					window.setTimeout(() => {
						label.textContent = original;
					}, 2000);
				}
			} catch {
				if (status) status.textContent = copyErrorText;
			}
		});
	}
</script>

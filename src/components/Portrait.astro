---
import { PortraitImage } from "~/islands/PortraitImage";
import { pickPortraitVariant, SILHOUETTES, TONES } from "~/lib/portrait";

interface Props {
	/** Voice id (or any stable string) — drives the deterministic silhouette. */
	seed: string;
	/** Real portrait URL. When undefined, only the silhouette renders. */
	src?: string;
	/** Optional DPR `srcset` (1×/2×) paired with `src` (DEV-74). */
	srcset?: string;
	/** Required alt text — typically "First name, country". */
	alt: string;
	/**
	 * Rendered size class. Drives the requested image width via
	 * `portraitUrl` (consumer call) and is forwarded here for any
	 * future size-specific styling. Default `tile`.
	 */
	size?: "tile" | "card";
	/**
	 * Above-the-fold LCP hint (DEV-129). Forwarded to `PortraitImage`:
	 * `true` loads eagerly at high priority for the first visible
	 * portrait(s); default `false` keeps the lazy below-fold load.
	 */
	priority?: boolean;
	class?: string;
}

const { seed, src, srcset, alt, priority = false, class: extraClass } = Astro.props;

const variant = pickPortraitVariant(seed);
const tone = TONES[variant.toneIndex]!;
const silhouette = SILHOUETTES[variant.silhouetteIndex]!;

// Inline custom properties match the prototype's CSS variable names
// so the gradient + silhouette positioning translate 1:1.
const containerStyle = [
	`background: linear-gradient(180deg, ${tone.a} 0%, ${tone.b} 100%)`,
	`--sil-c: ${tone.s}`,
	`--sil-w: ${variant.silWidth}%`,
	`--sil-x: ${variant.offsetX * 4}%`,
	`--sil-y: ${-variant.offsetY}%`,
].join("; ");
---

<div
	class:list={["rounded-field relative aspect-4/5 w-full overflow-hidden", extraClass]}
	style={containerStyle}
>
	<div class="absolute inset-0 flex items-end justify-center">
		<svg
			viewBox="0 0 100 120"
			preserveAspectRatio="xMidYMax meet"
			class="opacity-90"
			style="width: var(--sil-w); height: 92%; margin-bottom: var(--sil-y); margin-left: var(--sil-x); fill: var(--sil-c);"
			role="presentation"
			aria-hidden={src ? "true" : undefined}
			set:html={silhouette}
		/>
	</div>
	{
		src ? (
			<PortraitImage client:visible src={src} srcset={srcset} alt={alt} priority={priority} />
		) : (
			// Silhouette is the only thing rendered, so it carries the
			// accessible name via aria-label rather than being hidden.
			<span class="sr-only">{alt}</span>
		)
	}
</div>

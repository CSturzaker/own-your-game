---
import Wordmark from "~/components/Wordmark.astro";
import { isRtl, LOCALES } from "~/i18n/config";
import { makeT } from "~/i18n/astro";
import { localiseUrl } from "~/i18n/localise-url";
import { LanguageSwitcher } from "~/islands/LanguageSwitcher";
import { FOOTER_COLUMNS, META_LINKS } from "~/lib/footer";

interface Props {
	/**
	 * Currently active language code — shown in the switcher pill.
	 * Defaults to `Astro.currentLocale`; the locale also drives
	 * localisation of the footer's strings and internal links.
	 */
	lang?: string;
}

const { t, locale } = makeT(Astro.props.lang ?? Astro.currentLocale);
const year = new Date().getFullYear();

// The language switcher options — every locale, by its native name from
// the dictionary. The island can't call `t()` (it bundles every
// dictionary), so the names are resolved here and threaded in, along with
// the current path (for the target URL) and the popover direction.
const languageOptions = LOCALES.map((code) => ({ code, label: t(`languages.${code}`) }));
const switcherDir = isRtl(locale) ? "rtl" : "ltr";
const currentPath = Astro.url.pathname;
---

<footer
	class:list={[
		"bg-paper-2 border-rule grid border-t",
		"grid-cols-1 gap-7 px-4 pt-9 pb-6",
		"lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-10 lg:px-10 lg:pt-14 lg:pb-7",
	]}
>
	<div class="flex flex-col gap-4">
		{
			/* Brand block: the Own Your Game wordmark beside the UNICEF partner
		    mark (DEV-117). Per the handoff (hifi-shared.jsx footer): a
		    non-linked credit, 44px tall, alt="UNICEF". Kept separate from
		    Wordmark — the UNICEF mark is its own static <img>. */
		}
		<div class="flex flex-wrap items-center gap-7">
			<Wordmark size="footer" />
			<img src="/assets/unicef-logo.svg" alt="UNICEF" class="h-11 w-auto" />
		</div>
		<p class="text-caption/relaxed text-ink-2 max-w-[38ch]">{t("footer.description")}</p>
		<LanguageSwitcher
			client:idle
			current={locale}
			options={languageOptions}
			currentPath={currentPath}
			dir={switcherDir}
		/>
	</div>

	{
		FOOTER_COLUMNS.map((column) => (
			<div>
				<h2 class="font-display text-kicker tracking-14 text-ink mb-4 font-bold uppercase">
					{t(`footer.columns.${column.key}.heading`)}
				</h2>
				<ul class="flex flex-col">
					{column.items.map((item) => (
						<li>
							<a
								href={
									!item.external && item.href.startsWith("/")
										? localiseUrl(item.href, locale)
										: item.href
								}
								data-todo={item.todo}
								target={item.external ? "_blank" : undefined}
								rel={item.external ? "noopener noreferrer" : undefined}
								class="text-caption text-deep-cyan my-1.5 block underline-offset-2 hover:underline"
							>
								{item.labelKey ? t(`footer.columns.${column.key}.${item.labelKey}`) : item.label}
								{item.external && <span class="sr-only"> {t("common.opensInNewTab")}</span>}
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}

	<div
		class:list={[
			"border-rule text-caption text-ink-2 col-span-full mt-2 flex flex-col gap-2 border-t pt-5",
			"lg:flex-row lg:items-center lg:justify-between lg:gap-4",
		]}
	>
		<p>{t("footer.copyright", { year })}</p>
		<ul class="flex flex-wrap items-center gap-4">
			{
				META_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							data-todo={link.todo}
							class="text-ink-2 hover:text-ink underline-offset-2 hover:underline"
						>
							{t(`footer.meta.${link.key}`)}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

---
/**
 * The Squad — `/squad` (English) and `/{lang}/squad` (localised).
 *
 * Extracted from `src/pages/squad.astro` in DEV-69. UI string
 * translation (kicker, subtitle, filter labels, load-more, empty state)
 * lands in DEV-70; the filter/grid islands take their localised strings
 * then. Reference: `design/handoff/project/hifi-squad.jsx` lines 4–87.
 *
 * Header H1 follows the prototype's two variants: desktop spells the
 * count out in words, mobile uses the numeral + "voices." (see
 * `src/lib/squad.ts`). Both are driven by the live voice count.
 *
 * All voice data is pre-rendered as JSON-in-script (`#squad-data`) so
 * the filter/grid islands read it synchronously with no network fetch.
 * The page ships zero tiles; the grid island (DEV-60) hydrates and
 * renders from the URL filter state (DEV-59).
 */

import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import Kicker from "~/components/Kicker.astro";
import { isRtl } from "~/i18n/config";
import { makeT } from "~/i18n/astro";
import { buildSquadFiltersStrings, buildSquadGridStrings } from "~/i18n/squad-strings";
import { SquadFilters } from "~/islands/SquadFilters";
import { SquadGrid } from "~/islands/SquadGrid";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getAllVoices, getCountryCount, getVoiceCount } from "~/lib/content";
import { formatVoiceCount } from "~/lib/header";
import { portraitSrcset } from "~/lib/portrait-url";
import { squadHeadlineDesktop } from "~/lib/squad";
import { sortByNewest } from "~/lib/squad-grid";

const { t, locale } = makeT(Astro.currentLocale);
const count = getVoiceCount();
const countryCount = getCountryCount();
const voices = getAllVoices();
const headlineMobile = t("squad.headlineMobile", { count: formatVoiceCount(count) });
// Desktop spells the count out in words — English only (number-to-words
// is locale-specific and wasn't translated). Other locales reuse the
// numeral headline at both breakpoints.
const headlineDesktop = locale === "en" ? squadHeadlineDesktop(count) : headlineMobile;
const squadDataJson = JSON.stringify({ voices });

// Localised strings for the two filter/grid islands — resolved here so
// the dictionaries never ship to the client.
const filtersStrings = buildSquadFiltersStrings(t);
const gridStrings = buildSquadGridStrings(t, locale);

// LCP preload (DEV-129): the grid hydrates `client:idle` and renders its
// tiles after, so the first row's portraits would otherwise start
// downloading late and unprioritised — `/squad` is the worst page in RUM.
// On a plain (unfiltered) visit the leading tiles are deterministic (the
// newest voices, mirroring SquadGrid's sort), so preload the first row.
// The `imagesrcset` mirrors the tile <img>'s 1×/2× density srcset so the
// browser reuses the preloaded resource at the right DPR; gated to an
// absolute URL (no preload worth emitting without the account hash).
const PRELOAD_TILE_COUNT = 3;
const preloadTileSrcsets = sortByNewest(voices)
	.slice(0, PRELOAD_TILE_COUNT)
	.map((v) => v.portraitImageId)
	.filter((id): id is string => Boolean(id))
	.map((id) => portraitSrcset(id, "tile"))
	.filter((srcset) => /^https?:\/\//i.test(srcset));
---

<BaseLayout title="The Squad" ogImage="/og/squad.png">
	{
		preloadTileSrcsets.map((imagesrcset) => (
			<link slot="head" rel="preload" as="image" imagesrcset={imagesrcset} fetchpriority="high" />
		))
	}
	<Header slot="header" active="squad" count={count} countryCount={countryCount} sticky />

	<main
		id="main"
		class:list={["flex flex-col gap-5 lg:gap-8", "px-4 pt-6 pb-12 lg:px-14 lg:pt-12 lg:pb-20"]}
	>
		<section>
			<Kicker>{t("squad.kicker")}</Kicker>
			<div
				class:list={[
					"mt-4 flex flex-col gap-2",
					"lg:flex-row lg:flex-wrap lg:items-baseline lg:justify-between lg:gap-6",
				]}
			>
				<h1
					class="font-display tracking-team-sheet text-[42px] leading-none font-bold uppercase lg:basis-full lg:text-[72px]"
				>
					<span class="lg:hidden">{headlineMobile}</span>
					<span class="hidden lg:inline">{headlineDesktop}</span>
				</h1>
				<p
					class="font-display text-ink-2 text-small lg:text-h3 leading-[1.3] font-medium lg:max-w-[30ch]"
				>
					{t("squad.subtitle")}
				</p>
			</div>
		</section>

		{
			/* Filter bar — single-select theme/country/language/age dropdowns.
		    Selection narrows the grid + syncs to the URL in DEV-59. */
		}
		<SquadFilters
			client:idle
			strings={filtersStrings}
			voices={voices}
			dir={isRtl(locale) ? "rtl" : "ltr"}
		/>

		{
			/* Responsive grid of voice tiles, with the load-more control
		    below it. Reads the #squad-data block and the URL filter state
		    on mount, renders skeletons until then, re-filters on the
		    SquadFilters broadcast, and paginates 24 at a time. */
		}
		<SquadGrid client:idle strings={gridStrings} total={voices.length} />

		{
			/* All voices, pre-rendered for the filter/grid islands. Public
		    data only (first names, no surnames — enforced by the Voice
		    schema), identical to what the tiles render. */
		}
		<script type="application/json" id="squad-data" is:inline set:html={squadDataJson} />
	</main>

	<Footer slot="footer" />
</BaseLayout>

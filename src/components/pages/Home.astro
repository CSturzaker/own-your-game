---
/**
 * Home page body — `/` (English) and `/{lang}/` (localised).
 *
 * Extracted from `src/pages/index.astro` in DEV-69 so the same body
 * renders at the unprefixed English route and at each `[lang]/` route.
 * The thin page files only choose the route; this component reads
 * `Astro.currentLocale` and renders locale-correct copy (via `t()`) and
 * internal links.
 */

import Button from "~/components/Button.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import Kicker from "~/components/Kicker.astro";
import Tagline from "~/components/Tagline.astro";
import Wordmark from "~/components/Wordmark.astro";
import CampaignFilm from "~/components/home/CampaignFilm.astro";
import StartingEleven from "~/components/home/StartingEleven.astro";
import VoiceCounterCard from "~/components/home/VoiceCounterCard.astro";
import WhyThisBand from "~/components/home/WhyThisBand.astro";
import { makeT } from "~/i18n/astro";
import { localiseUrl } from "~/i18n/localise-url";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getAllVoices, getCountryCount, getVoiceCount } from "~/lib/content";
import { formatVoiceCount } from "~/lib/header";

const { t, locale } = makeT(Astro.currentLocale);
const count = getVoiceCount();
const countryCount = getCountryCount();
// The squad CTA counts people to meet (voices); the hero counter card now
// leads on reach (countries) — DEV-119.
const squadLabel = t("home.ctaSquad", { count: formatVoiceCount(count) });
const voices = getAllVoices();
---

<BaseLayout title="Own Your Game" ogImage="/og/home.png" titleSuffix={false}>
	<Header slot="header" active="home" count={count} countryCount={countryCount} />

	<div class="flex flex-col gap-20 px-4 pt-6 pb-12 lg:gap-20 lg:px-14 lg:pt-12 lg:pb-20">
		{
			/* The page's single <h1> — a visually-hidden orientation landmark
		   for screen readers (the visual hero leads with the wordmark image
		   plus the tagline, neither of which is semantically a heading). It
		   precedes the <h2> section headings so the hierarchy descends
		   cleanly h1 -> h2. See DEV-86. */
		}
		<h1 class="sr-only">{t("home.srHeading")}</h1>

		{
			/* HERO + CAMPAIGN FILM — the V5 "fold-aware overlap"
		   (hifi-home-video.jsx): the 9:16 film is the hero's right-hand
		   element and spans down past the hero copy into the second beat,
		   so the fold crops it mid-frame at common viewport heights — the
		   scroll cue. One CTA per beat: hero → letter, film → squad. On
		   mobile the overlap doesn't apply: a deliberately tight hero
		   (smaller wordmark, no standfirst — the tagline carries it), then
		   the film section with the second-beat copy. The second beat is
		   rendered twice (left column on desktop, under the poster on
		   mobile) because the two layouts need it on opposite sides of the
		   film in DOM order. */
		}
		<section
			class:list={["grid grid-cols-1 gap-10", "lg:grid-cols-[1fr_400px] lg:items-start lg:gap-24"]}
		>
			<div>
				<Kicker class="lg:text-kicker mb-4 text-[10px] lg:mb-8">
					{/* home hero kicker — shorter on mobile per the prototype. */}
					<span class="lg:hidden">{t("home.kickerMobile")}</span>
					<span class="hidden lg:inline">{t("home.kickerDesktop")}</span>
				</Kicker>

				{
					/* hero variant emits inline `height: 96px`; the !important on
				    the lg utility overrides it to 200px on desktop. */
				}
				<Wordmark size="hero" height={96} class="lg:h-[200px]!" />

				<Tagline
					class="mt-4 max-w-[22ch] text-[24px] leading-[1.15] lg:mt-7 lg:text-[40px] lg:leading-[1.1]"
				>
					{t("tagline.question")}
				</Tagline>

				{/* Standfirst — desktop only; the mobile hero stays tight. */}
				<p
					class:list={[
						"font-body text-ink-2 hidden leading-[1.55]",
						"lg:mt-7 lg:block lg:max-w-[42ch] lg:text-[18px]",
					]}
				>
					{t("home.supporting")}
				</p>

				<div class="mt-6 flex flex-col lg:mt-10 lg:flex-row">
					<Button href={localiseUrl("/letter", locale)} size="lg" iconRight="→">
						{t("home.ctaLetter")}
					</Button>
				</div>

				{/* Second beat (desktop) — the film answers the tagline above. */}
				<div data-film-beat class="mt-22 hidden max-w-[560px] lg:block">
					<Kicker>{t("home.film.kicker")}</Kicker>
					<h2
						class:list={[
							"font-display tracking-team-sheet mt-5 font-bold text-balance uppercase",
							"text-[56px] leading-[1.02]",
						]}
					>
						{t("home.film.headline")}
					</h2>
					<div class="mt-10 flex">
						<Button href={localiseUrl("/squad", locale)} size="lg" iconRight="→">
							{squadLabel}
						</Button>
					</div>
				</div>
			</div>

			<div>
				<CampaignFilm />

				{/* Second beat (mobile) — below the poster in the film section. */}
				<div data-film-beat class="mt-7 lg:hidden">
					<Kicker class="text-[10px]">{t("home.film.kicker")}</Kicker>
					<h2
						class:list={[
							"font-display tracking-team-sheet mt-3 font-bold text-balance uppercase",
							"text-[28px] leading-[1.05]",
						]}
					>
						{t("home.film.headline")}
					</h2>
					<div class="mt-6 flex flex-col">
						<Button href={localiseUrl("/squad", locale)} size="lg" iconRight="→">
							{squadLabel}
						</Button>
					</div>
				</div>
			</div>
		</section>

		{
			/* COUNTRY COUNTER — relocated out of the hero into its own
		   full-width brand band (DEV-124; hifi-home-video.jsx
		   CountryCounterBand). */
		}
		<VoiceCounterCard count={countryCount} />

		<StartingEleven voices={voices} fetchPool />

		<WhyThisBand />
	</div>

	<Footer slot="footer" />
</BaseLayout>

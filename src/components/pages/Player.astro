---
/**
 * Player card — standalone direct-visit page for `/voice/{id}` (English)
 * and `/{lang}/voice/{id}` (localised). Rendered when someone opens or
 * shares a card link directly (vs. the modal overlay a tile click opens
 * over the home/squad page — see `PlayerCardOverlay`).
 *
 * The body is server-rendered for SEO and no-JS visitors: `PlayerCard`
 * is a React component included without a `client:*` directive, so Astro
 * emits it as static HTML and ships no JS for it. The same component is
 * client-rendered inside the modal, so both paths show identical content.
 *
 * Layout: desktop renders the two-column card inline (the issue's
 * "inline" variant — framed, no scrim/close). Mobile (DEV-45) is the
 * full-screen experience: a tile click navigates here (the overlay skips
 * interception below `lg`), the video is full-bleed with its own chrome
 * (close, play affordance, swipe hint).
 *
 * `PlayerControls` (client) progressively enhances the SSR footer to the
 * active set (DEV-48): it scopes prev/next to the `from`/filter params,
 * fills the dot indicator + label, and adds swipe + arrow-key traversal.
 * The SSR full-list prev/next is the no-JS baseline (and already correct
 * for a plain direct visit, whose active set is all voices).
 */

import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { makeT } from "~/i18n/astro";
import { localiseUrl } from "~/i18n/localise-url";
import { isRtl } from "~/i18n/config";
import { buildPlayerStrings } from "~/i18n/player-strings";
import { PlayerCard } from "~/islands/PlayerCard";
import { PlayerChips } from "~/islands/PlayerChips";
import { PlayerControls } from "~/islands/PlayerControls";
import { StreamPlayer } from "~/islands/StreamPlayer";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getAllVoices, getTranscript, getVoiceCount } from "~/lib/content";
import { playerOgImage, playerTitle, voiceNeighbours, voicePosition } from "~/lib/player";
import { portraitUrl } from "~/lib/portrait-url";
import type { Voice } from "~/lib/voice";

interface Props {
	voice: Voice;
}

const { voice } = Astro.props;
const { t, locale } = makeT(Astro.currentLocale);

const voices = getAllVoices();
const count = getVoiceCount();
const position = voicePosition(voice.id, voices);
const { prev, next } = voiceNeighbours(voice.id, voices);
const strings = buildPlayerStrings(t);

// SSR (no-JS) baseline: the full newest-first neighbours. PlayerControls
// rewrites these to the active set on hydration.
const prevHref = prev ? localiseUrl(`/voice/${prev.id}`, locale) : undefined;
const nextHref = next ? localiseUrl(`/voice/${next.id}`, locale) : undefined;

const squadHref = localiseUrl("/squad", locale);
const homeHref = localiseUrl("/", locale);

const videoTitle = t("player.video.title", { name: voice.firstName });
const posterImage = voice.portraitImageId ? portraitUrl(voice.portraitImageId, "card") : undefined;

const voicePath = localiseUrl(`/voice/${voice.id}`, locale);
const transcript = getTranscript(voice.id) ?? undefined;
const shareTitle = t("player.chips.shareTitle", { name: voice.firstName });
const dir = isRtl(locale) ? "rtl" : "ltr";
---

<BaseLayout title={playerTitle(voice)} description={voice.pullQuote} ogImage={playerOgImage(voice)}>
	<Header slot="header" count={count} sticky />

	{/* Full-bleed on mobile (the video reaches the edges); a framed card on desktop. */}
	<div class="mx-auto w-full max-w-[1100px] lg:px-6 lg:pt-12 lg:pb-24">
		<div
			class="lg:bg-paper lg:border-rule lg:rounded-card lg:overflow-hidden lg:border lg:shadow-[0_24px_64px_rgba(20,14,0,0.10)]"
		>
			<PlayerCard
				voice={voice}
				position={position}
				total={voices.length}
				strings={strings}
				prevHref={prevHref}
				nextHref={nextHref}
				showMobileChrome
			>
				<StreamPlayer
					client:idle
					videoId={voice.videoId}
					title={videoTitle}
					posterImage={posterImage}
					strings={strings.video}
					className="aspect-9/12 lg:aspect-video"
				/>
				<PlayerChips
					client:idle
					slot="chips"
					videoId={voice.videoId}
					language={voice.language}
					voicePath={voicePath}
					ogImagePath={`/og/voice/${voice.id}.png`}
					shareTitle={shareTitle}
					transcript={transcript}
					strings={strings.chips}
					dir={dir}
				/>
			</PlayerCard>
		</div>
	</div>

	<PlayerControls
		client:idle
		voiceId={voice.id}
		voices={voices}
		strings={strings}
		locale={locale}
		squadHref={squadHref}
		homeHref={homeHref}
	/>

	<Footer slot="footer" />
</BaseLayout>

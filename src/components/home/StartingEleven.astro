---
/**
 * Starting eleven — the home page's football team sheet.
 *
 * Reference: `design/handoff/project/hifi-home.jsx` lines 131–214
 * (desktop) and 335–369 (mobile).
 *
 * DEV-38 shipped the static formation + 2×4 mobile grid here as
 * pure Astro markup. DEV-39 moved the live composition (header
 * title, formation, mobile grid, pause + countdown controls,
 * reduced-motion pill) into a React island so the rotation timer
 * can drive tile swaps client-side without losing the SSR
 * fallback (Astro pre-renders the island server-side, React
 * hydrates on top).
 *
 * The Astro shell keeps just:
 *   - the `<section>` wrapper
 *   - a loading branch that renders skeleton tiles (no island)
 *     for the demo page's preview-only "loading" state — there's
 *     no real loading state at runtime because voices.json is
 *     read at build time
 *   - the "Bring on the next eleven" amber CTA below the body
 *     (still an unwired stub — DEV-39 explicitly out-of-scopes
 *     a manual re-shuffle button)
 *
 * Everything else lives in `~/islands/RotatingEleven.tsx`.
 */

import Button from "~/components/Button.astro";
import Kicker from "~/components/Kicker.astro";
import Tile from "~/components/Tile.astro";
import { makeT } from "~/i18n/astro";
import { RotatingEleven } from "~/islands/RotatingEleven";
import { MOBILE_TILE_COUNT } from "~/lib/starting-eleven";
import type { Voice } from "~/lib/voice";

interface Props {
	/** Voices to render. Sliced to ≤11 for desktop, ≤8 for mobile. */
	voices: readonly Voice[];
	/** Render skeleton tiles + no controls instead of the live island. */
	loading?: boolean;
	/**
	 * Force the reduced-motion pill regardless of the OS preference.
	 * Demo-only — at runtime the island reads `prefers-reduced-motion`
	 * via `matchMedia` directly.
	 */
	reducedMotion?: boolean;
}

const { voices, loading = false, reducedMotion = false } = Astro.props as Props;
const { t } = makeT(Astro.currentLocale);

// Localised strings the rotation island renders client-side. Resolved
// here so the dictionaries never reach the browser; `countdown` and
// `tileAccessibleName` are `{var}` templates the island interpolates.
const elevenStrings = {
	kicker: t("home.startingEleven.kicker"),
	heading: t("home.startingEleven.heading"),
	supporting: t("home.startingEleven.supporting"),
	pause: t("home.startingEleven.pauseLabel"),
	resume: t("home.startingEleven.resumeLabel"),
	pauseShort: t("home.startingEleven.pauseShort"),
	resumeShort: t("home.startingEleven.resumeShort"),
	paused: t("home.startingEleven.paused"),
	reducedMotion: t("home.startingEleven.reducedMotionPill"),
	countdownTemplate: t("home.startingEleven.countdown"),
	tileAccessibleName: t("tile.accessibleName"),
};
---

<section class="flex flex-col gap-8">
	{
		loading ? (
			<>
				{/* Skeleton fallback — demo-only, no rotation, no controls.
				    Mirrors the DEV-38 static layout so the demo can preview
				    the loading state. */}
				<header>
					<Kicker class="lg:text-kicker text-[10px]">{t("home.startingEleven.kicker")}</Kicker>
					<h2
						class:list={[
							"font-display tracking-team-sheet mt-3 font-bold uppercase",
							"text-[26px] leading-none lg:mt-4 lg:text-[48px]",
						]}
					>
						{t("home.startingEleven.heading")}
					</h2>
				</header>

				<div data-eleven-formation class="hidden flex-col gap-[18px] lg:flex">
					<div class="grid grid-cols-1 px-[42%]">
						<Tile skeleton />
					</div>
					<div class="grid grid-cols-4 gap-[18px]">
						{Array.from({ length: 4 }, () => (
							<Tile skeleton />
						))}
					</div>
					<div class="grid grid-cols-3 gap-[18px] px-[11%]">
						{Array.from({ length: 3 }, () => (
							<Tile skeleton />
						))}
					</div>
					<div class="grid grid-cols-3 gap-[18px] px-[17%]">
						{Array.from({ length: 3 }, () => (
							<Tile skeleton />
						))}
					</div>
				</div>

				<div data-eleven-mobile class="grid grid-cols-2 gap-2 lg:hidden">
					{Array.from({ length: MOBILE_TILE_COUNT }, () => (
						<Tile skeleton />
					))}
				</div>
			</>
		) : (
			// client:idle (not client:visible) so the React hydration
			// work happens after the browser's first idle window —
			// moves it out of the Lighthouse TBT measurement on a
			// cold load. The user-visible rotation still kicks in
			// well before the section is scrolled into view; only
			// the hydration timing changes.
			<RotatingEleven
				client:idle
				strings={elevenStrings}
				initialVoices={voices.slice(0, 11)}
				allVoices={voices}
				forceReducedMotion={reducedMotion}
			/>
		)
	}

	{
		/* "Bring on the next eleven" — still a stub; DEV-39 explicitly
	    out-of-scopes a manual re-shuffle. Hidden when loading. */
	}
	{
		!loading && (
			<div class="hidden justify-center lg:flex">
				<Button variant="amber" size="lg" iconRight="↻">
					{t("home.startingEleven.nextElevenLabel")}
				</Button>
			</div>
		)
	}
</section>

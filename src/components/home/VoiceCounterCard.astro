---
/**
 * The voice counter card — the cyan brand moment on `/`.
 *
 * Reference: `design/handoff/project/hifi-home.jsx` lines 53–127
 * (desktop) and 289–325 (mobile). One of two largest brand moments
 * on the site; the other is the "ONE LETTER" closing band on About.
 *
 * Colour divergence from the prototype, agency review pending:
 *   The prototype paints this card in Process Cyan (#00AEEF) with
 *   white type. White on #00AEEF lands at ~2.5:1 — below WCAG AA at
 *   every text size on this card, including the 124px number (which
 *   fails the relaxed 3.0:1 large-text threshold by 0.49). The same
 *   trade-off forced Epic 3's Button primitives to swap their full
 *   brand fills for darker family companions (see the comment in
 *   `src/lib/primitives.ts` on Amber/Deep buttons). We mirror that
 *   pattern here: the fill is `bg-fairness` (#007AB1) — the existing
 *   AA-cleared cyan-family token already documented as an intentional
 *   divergence in `tests/unit/styles/design-tokens.test.ts`. Cyan
 *   family is preserved; AA is met; no new token introduced. Flag
 *   to the agency at some point — if they push back hard on brand
 *   fidelity we can revisit, but we shouldn't block on it now.
 *
 * Variant matrix:
 *   default              — cyan fill, live row, description
 *   loading              — number replaced by a [data-skeleton] block
 *                          + sr-only "Loading voice count" text. See
 *                          the inline comment by the skeleton for
 *                          why this deviates from the prototype's
 *                          "faded 246" placeholder.
 *   forceReducedMotion   — short live-row text + no pulse (demo only;
 *                          the OS preference drives the same behaviour
 *                          at runtime via CSS variant prefixes)
 *   error                — paper-2 background with ink type, neutral
 *                          dot, "reconnecting" message. Defensive
 *                          fallback for a missing voices.json; if the
 *                          build succeeds the data is fine and this
 *                          state should never paint in production.
 */

import { formatVoiceCount } from "~/lib/header";
import { VOICE_COUNTER_CARD_COPY } from "~/lib/voice-counter-card";

interface Props {
	/** Live voice total from `getVoiceCount()`. Ignored when loading. */
	count: number;
	/** Render the loading skeleton block in place of the number. */
	loading?: boolean;
	/** Render the paper/ink error fallback. */
	error?: boolean;
	/**
	 * Force the reduced-motion text + no-pulse treatment for visual
	 * review on the demo page. At runtime the OS preference drives
	 * the same behaviour through `motion-safe:` and the
	 * `prefers-reduced-motion` guard in `global.css`.
	 */
	forceReducedMotion?: boolean;
	/** Extra classes to merge onto the root (layout slot, e.g. `lg:self-stretch`). */
	class?: string;
}

const {
	count,
	loading = false,
	error = false,
	forceReducedMotion = false,
	class: extraClass,
} = Astro.props;

const display = formatVoiceCount(count);
const isError = error;
---

<section
	data-voice-counter-card
	data-error={isError ? "" : undefined}
	aria-label={VOICE_COUNTER_CARD_COPY.label}
	class:list={[
		"rounded-card relative overflow-hidden",
		"flex flex-col justify-end",
		"p-6 lg:p-9",
		"min-h-[200px] lg:min-h-[300px]",
		isError ? "bg-paper-2 border-rule text-ink border" : "bg-fairness text-white",
		extraClass,
	]}
>
	{
		!isError && (
			<div
				aria-hidden="true"
				class:list={[
					"absolute rounded-full bg-white/10",
					"-top-10 -right-10 size-[140px]",
					"lg:top-[-60px] lg:right-[-60px] lg:size-[200px]",
				]}
			/>
		)
	}

	<p
		class:list={[
			"font-display tracking-kicker text-kicker relative font-semibold uppercase lg:text-[12px]",
			// Prototype dimmed this to 78% white for visual hierarchy.
			// On #007AB1 that lands at 3.51:1, below AA. Full white
			// is 4.70:1; hierarchy still reads via uppercase + tracking.
			// On the error paper fill the eyebrow stays ink-2 — ink-3
			// on paper-2 lands at 4.42:1, below the AA threshold.
			isError ? "text-ink-2" : "text-white",
		]}
	>
		{VOICE_COUNTER_CARD_COPY.label}
	</p>

	{
		/*
	 The big number.

	 Loading-state deviation from the prototype: the spec asked for
	 the literal "246" rendered at opacity 40 as a "last-known
	 value" stand-in. At 40% the blended foreground (#66AFD0) lands
	 1.94:1 against #007AB1 — failing the relaxed 3:1 large-text
	 threshold by ~1.0. Axe's color-contrast rule runs against
	 visually-present text regardless of aria-hidden (it's a
	 low-vision concern, not just a screen-reader one) so there's
	 no opacity setting that both reads as "faded" and clears AA.
	 We swap to a skeleton block at the same dimensions instead,
	 reusing the project's `[data-skeleton]` hook from
	 `src/styles/global.css`. Mirrors Tile's loading treatment.
	*/
	}
	{
		loading ? (
			<>
				<span class="sr-only">{VOICE_COUNTER_CARD_COPY.loadingNumber}</span>
				<div
					data-skeleton
					aria-hidden="true"
					class="rounded-card relative mt-3 h-[72px] w-[180px] lg:mt-4 lg:h-[124px] lg:w-[280px]"
				/>
			</>
		) : (
			<p
				class:list={[
					"font-display tracking-display relative mt-3 font-bold tabular-nums lg:mt-4",
					"text-[72px] leading-[0.95] lg:text-[124px] lg:leading-[0.92]",
				]}
			>
				{display}
			</p>
		)
	}

	<div
		class:list={[
			"font-display tracking-14 text-kicker relative mt-3 flex items-center gap-2 font-semibold uppercase lg:mt-4 lg:gap-2.5 lg:text-[12px]",
			isError ? "text-ink-2" : "text-white",
		]}
	>
		<span
			aria-hidden="true"
			data-pulse={!isError && !forceReducedMotion ? "" : undefined}
			class:list={["rounded-pill block size-2", isError ? "bg-ink-3" : "bg-brand-orange"]}></span>
		{
			isError ? (
				<span>{VOICE_COUNTER_CARD_COPY.liveError}</span>
			) : forceReducedMotion ? (
				<span>{VOICE_COUNTER_CARD_COPY.liveShort}</span>
			) : (
				<>
					{/*
					 Mobile + reduced-motion (desktop) shows the short variant;
					 desktop with motion-safe shows the long one. Two spans,
					 hidden via motion-safe:lg: chains so the swap is
					 CSS-only — no flash of either text on initial paint.
					*/}
					<span class="inline motion-safe:lg:hidden">{VOICE_COUNTER_CARD_COPY.liveShort}</span>
					<span class="hidden motion-safe:lg:inline">{VOICE_COUNTER_CARD_COPY.liveLong}</span>
				</>
			)
		}
	</div>

	{
		/* Description block — desktop only on the live card; always
	    visible on the error fallback so the offline reason actually
	    reaches users at any viewport. */
	}
	<p
		class:list={[
			"font-body relative mt-4 max-w-[32ch] text-[14px] leading-[1.55]",
			// Prototype dimmed this to 88% white. On #007AB1 that's
			// 4.03:1 — below AA. Full white is 4.70:1.
			isError ? "text-ink-2 block" : "hidden text-white lg:block",
		]}
	>
		{isError ? VOICE_COUNTER_CARD_COPY.descriptionError : VOICE_COUNTER_CARD_COPY.description}
	</p>
</section>

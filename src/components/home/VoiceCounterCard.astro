---
/**
 * The country counter band — the cyan brand moment on `/`.
 *
 * Reference: `design/handoff/project/hifi-home-video.jsx`
 * (`CountryCounterBand`). DEV-124 relocated it out of the hero (where
 * it was the right-column card from the now-superseded `hifi-home.jsx`)
 * into a full-width band between the hero and the starting eleven, and
 * restyled it to the band layout: `auto 1fr`, the large number left,
 * the description right. Still one of the two largest brand moments on
 * the site; the other is the "ONE LETTER" closing band on About.
 *
 * Static treatment — the live-pulse row is gone (with the band
 * restyle, per the prototype's annotation): the country count grows in
 * steps, not ticks, so a "live" dot would read as stalled most of the
 * time. The copy stays country-framed (DEV-119), not the prototype's
 * re-render drift ("aged 11–18" — see the DEV-124 non-goals).
 *
 * Colour divergence from the prototype, agency review pending:
 *   The prototype paints this band in Process Cyan (#00AEEF) with
 *   white type. White on #00AEEF lands at ~2.5:1 — below WCAG AA at
 *   every text size on this band, including the 124px number (which
 *   fails the relaxed 3.0:1 large-text threshold by 0.49). The same
 *   trade-off forced Epic 3's Button primitives to swap their full
 *   brand fills for darker family companions (see the comment in
 *   `src/lib/primitives.ts` on Amber/Deep buttons). We mirror that
 *   pattern here: the fill is `bg-fairness` (#007AB1) — the existing
 *   AA-cleared cyan-family token already documented as an intentional
 *   divergence in `tests/unit/styles/design-tokens.test.ts`. Cyan
 *   family is preserved; AA is met; no new token introduced. Flag
 *   to the agency at some point — if they push back hard on brand
 *   fidelity we can revisit, but we shouldn't block on it now.
 *
 * Variant matrix:
 *   default — cyan fill, the live country count, description
 *   loading — number replaced by a [data-skeleton] block + sr-only
 *             "Loading country count" text. See the inline comment by
 *             the skeleton for why this deviates from the prototype's
 *             "faded 16" placeholder.
 *   error   — paper-2 background with ink type, offline message.
 *             Defensive fallback for a missing voices.json; if the
 *             build succeeds the data is fine and this state should
 *             never paint in production.
 */

import { makeT } from "~/i18n/astro";
import { formatVoiceCount } from "~/lib/header";

interface Props {
	/**
	 * The figure to display. Since DEV-119 the counter leads on reach,
	 * so callers pass the country count (`getCountryCount()`); the copy
	 * (`home.voiceCounter.*`) is country-framed to match. Ignored when
	 * loading. (The component name + i18n namespace keep "voiceCounter"
	 * to limit churn — they now render the country total.)
	 */
	count: number;
	/** Render the loading skeleton block in place of the number. */
	loading?: boolean;
	/** Render the paper/ink error fallback. */
	error?: boolean;
	/** Extra classes to merge onto the root (layout slot). */
	class?: string;
}

const { count, loading = false, error = false, class: extraClass } = Astro.props;

const { t } = makeT(Astro.currentLocale);
const display = formatVoiceCount(count);
const isError = error;
---

<section
	data-voice-counter-card
	data-error={isError ? "" : undefined}
	aria-label={t("home.voiceCounter.label")}
	class:list={[
		"rounded-card relative overflow-hidden",
		"grid grid-cols-1 items-end gap-4 p-6",
		"lg:grid-cols-[auto_1fr] lg:gap-16 lg:p-12",
		isError ? "bg-paper-2 border-rule text-ink border" : "bg-fairness text-white",
		extraClass,
	]}
>
	{
		!isError && (
			<div
				aria-hidden="true"
				class:list={[
					"absolute rounded-full bg-white/10",
					"-inset-e-10 -top-10 size-[140px]",
					"lg:inset-e-[-60px] lg:top-[-60px] lg:size-[200px]",
				]}
			/>
		)
	}

	<div class="relative">
		<p
			class:list={[
				"font-display tracking-kicker text-kicker font-semibold uppercase lg:text-[12px]",
				// Prototype dimmed this to 78% white for visual hierarchy.
				// On #007AB1 that lands at 3.51:1, below AA. Full white
				// is 4.70:1; hierarchy still reads via uppercase + tracking.
				// On the error paper fill the eyebrow stays ink-2 — ink-3
				// on paper-2 lands at 4.42:1, below the AA threshold.
				isError ? "text-ink-2" : "text-white",
			]}
		>
			{t("home.voiceCounter.label")}
		</p>

		{
			/*
		 The big number.

		 Loading-state deviation from the prototype: the spec asked for
		 the last-known value rendered at opacity 40 as a stand-in. At
		 40% the blended foreground (#66AFD0) lands 1.94:1 against
		 #007AB1 — failing the relaxed 3:1 large-text threshold by ~1.0.
		 Axe's color-contrast rule runs against visually-present text
		 regardless of aria-hidden (it's a low-vision concern, not just
		 a screen-reader one) so there's no opacity setting that both
		 reads as "faded" and clears AA. We swap to a skeleton block at
		 the same dimensions instead, reusing the project's
		 `[data-skeleton]` hook from `src/styles/global.css`. Mirrors
		 Tile's loading treatment.
		*/
		}
		{
			loading ? (
				<>
					<span class="sr-only">{t("home.voiceCounter.loadingNumber")}</span>
					<div
						data-skeleton
						aria-hidden="true"
						class="rounded-card mt-3 h-[72px] w-[180px] lg:mt-4 lg:h-[124px] lg:w-[280px]"
					/>
				</>
			) : (
				<p
					class:list={[
						"font-display tracking-display mt-3 font-bold tabular-nums lg:mt-4",
						"text-[72px] leading-[0.95] lg:text-[124px] lg:leading-[0.92]",
					]}
				>
					{display}
				</p>
			)
		}
	</div>

	<p
		class:list={[
			"font-body relative max-w-[40ch] leading-[1.55]",
			"lg:text-small text-[14px] lg:pb-1.5",
			// Prototype dimmed this to 90% white. On #007AB1 that's
			// ~4.2:1 — below AA. Full white is 4.70:1.
			isError ? "text-ink-2" : "text-white",
		]}
	>
		{isError ? t("home.voiceCounter.descriptionError") : t("home.voiceCounter.description")}
	</p>
</section>

---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { DialogDemo } from "~/islands/_demo/DialogDemo";
---

<BaseLayout title="Dialog demo — Own Your Game">
	<main class="mx-auto max-w-3xl px-6 py-16">
		<p class="font-display text-kicker tracking-kicker text-ink-3 uppercase">demo</p>
		<h1 class="font-display text-h1 tracking-display mt-2">Dialog wrapper</h1>
		<p class="text-body text-ink-2 mt-4 max-w-prose">
			Manual verification surface for <code>~/islands/ui/Dialog</code>. Triggers a Radix Dialog with
			the project default treatment (ink scrim, paper card, 4px radius, large shadow). Use it to
			confirm focus trap, Escape-to-close, and click-outside-to-close behaviour on a real page.
		</p>
		<div class="mt-8">
			<DialogDemo client:load />
		</div>
	</main>
</BaseLayout>

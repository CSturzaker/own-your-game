---
import VoiceCounterCard from "~/components/home/VoiceCounterCard.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Voice counter card demo" noIndex>
	<section class="mx-auto max-w-6xl px-6 py-16">
		<p class="font-display text-kicker tracking-kicker text-ink-3 uppercase">demo</p>
		<h1 class="font-display text-h1 tracking-display mt-2">Voice counter card</h1>
		<p class="text-body text-ink-2 mt-4 max-w-prose">
			The Process Cyan brand moment that anchors the right column of the home hero. White type on
			Process Cyan is below WCAG AA — this card is the documented exception preserved at the
			agency's request, so the page-level axe scan scopes around the
			<code>[data-voice-counter-card]</code> hook. Live state is driven by
			<code>prefers-reduced-motion</code>: the dot pulse stops and the long live-row text collapses
			to the short "Voices and counting" copy.
		</p>

		<div class="mt-12 grid gap-12 lg:grid-cols-2">
			<article aria-labelledby="demo-default">
				<h2
					id="demo-default"
					class="font-display text-kicker tracking-kicker text-ink-3 mb-4 uppercase"
				>
					Default — count 247
				</h2>
				<VoiceCounterCard count={247} />
			</article>

			<article aria-labelledby="demo-reduced">
				<h2
					id="demo-reduced"
					class="font-display text-kicker tracking-kicker text-ink-3 mb-4 uppercase"
				>
					Forced reduced-motion — no pulse, short copy
				</h2>
				<VoiceCounterCard count={247} forceReducedMotion />
			</article>

			<article aria-labelledby="demo-loading">
				<h2
					id="demo-loading"
					class="font-display text-kicker tracking-kicker text-ink-3 mb-4 uppercase"
				>
					Loading — skeleton block (deviates from prototype)
				</h2>
				<VoiceCounterCard count={247} loading />
			</article>

			<article aria-labelledby="demo-error">
				<h2
					id="demo-error"
					class="font-display text-kicker tracking-kicker text-ink-3 mb-4 uppercase"
				>
					Error fallback — paper / ink, defensive only
				</h2>
				<VoiceCounterCard count={247} error />
			</article>
		</div>

		<h2 class="font-display text-h2 tracking-display mt-16">Live OS preference test</h2>
		<p class="text-body text-ink-2 mt-4 max-w-prose">
			Toggle <code>System Settings → Accessibility → Display → Reduce motion</code> while focused on the
			card below — the pulse should stop and the live-row text should collapse to "Voices and counting"
			without a reload. The
			<code>forceReducedMotion</code> variant above mirrors this exact treatment for static review.
		</p>
		<div class="mt-6 max-w-md">
			<VoiceCounterCard count={247} />
		</div>
	</section>
</BaseLayout>

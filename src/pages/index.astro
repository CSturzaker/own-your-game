---
import Button from "~/components/Button.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import Kicker from "~/components/Kicker.astro";
import Tagline from "~/components/Tagline.astro";
import Wordmark from "~/components/Wordmark.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getVoiceCount } from "~/lib/content";
import { HOME_COPY, ctaSquadLabel } from "~/lib/home";

const count = getVoiceCount();
const squadLabel = ctaSquadLabel(count);
---

<BaseLayout title="Own Your Game" ogImage="/og/home.png" titleSuffix={false}>
	<Header slot="header" active="home" count={count} />

	<div class="flex flex-col gap-20 px-4 pt-6 pb-12 lg:gap-20 lg:px-14 lg:pt-12 lg:pb-20">
		{/* HERO — 2-column grid on desktop (1.25fr 1fr), stacked on mobile. */}
		<section
			class:list={["grid grid-cols-1 gap-10", "lg:grid-cols-[1.25fr_1fr] lg:items-end lg:gap-14"]}
		>
			<div>
				<Kicker class="lg:text-kicker mb-5 text-[10px] lg:mb-8">
					{/* i18n: home hero kicker — shorter on mobile per the prototype. */}
					<span class="lg:hidden">{HOME_COPY.kickerMobile}</span>
					<span class="hidden lg:inline">{HOME_COPY.kickerDesktop}</span>
				</Kicker>

				{
					/* hero variant emits inline `height: 120px`; the !important on
				    the lg utility overrides it to 200px on desktop. */
				}
				<Wordmark size="hero" height={120} class="lg:h-[200px]!" />

				<Tagline
					class="mt-5 max-w-[22ch] text-[24px] leading-[1.15] lg:mt-7 lg:text-[40px] lg:leading-[1.1]"
				>
					{HOME_COPY.tagline}
				</Tagline>

				<p
					class:list={[
						"font-body text-ink-2 mt-5 max-w-[32ch]",
						"text-small leading-[1.55]",
						"lg:mt-7 lg:max-w-[42ch] lg:text-[18px]",
					]}
				>
					{/* i18n: home supporting paragraph. */}
					{HOME_COPY.supportingParagraph}
				</p>

				<div class="mt-8 flex flex-col gap-3 lg:mt-10 lg:flex-row lg:flex-wrap lg:gap-4">
					<Button href="/letter" size="lg" iconRight="→">{HOME_COPY.ctaLetter}</Button>
					<Button href="/squad" variant="ghost" size="lg">{squadLabel}</Button>
				</div>
			</div>

			{/* Voice counter card — replaced in DEV-37 with the Process Cyan brand moment. */}
			<div
				data-stub="voice-counter"
				class:list={[
					"bg-paper-2 border-rule rounded-card border",
					"min-h-[200px] p-6",
					"flex items-end",
					"lg:min-h-[300px] lg:self-stretch lg:p-9",
				]}
				aria-hidden="true"
			>
				<span class="font-display text-kicker tracking-kicker text-ink-2 uppercase">
					Voice counter — DEV-37
				</span>
			</div>
		</section>

		{/* Starting eleven — replaced in DEV-38. */}
		<section
			data-stub="starting-eleven"
			class:list={[
				"bg-paper-2 border-rule rounded-card border",
				"min-h-[240px] p-6 lg:min-h-[420px] lg:p-9",
				"flex items-end",
			]}
			aria-hidden="true"
		>
			<span class="font-display text-kicker tracking-kicker text-ink-2 uppercase">
				Starting eleven — DEV-38
			</span>
		</section>

		{/* Why this letter band — replaced in DEV-40. */}
		<section
			data-stub="why-this"
			class:list={[
				"bg-paper-2 border-rule rounded-card border",
				"min-h-[180px] p-6 lg:min-h-[280px] lg:p-9",
				"flex items-end",
			]}
			aria-hidden="true"
		>
			<span class="font-display text-kicker tracking-kicker text-ink-2 uppercase">
				Why this letter — DEV-40
			</span>
		</section>
	</div>

	<Footer slot="footer" count={count} lang="en" />
</BaseLayout>

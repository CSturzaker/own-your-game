---
/**
 * The Letter — `/letter`.
 *
 * Reference: `design/handoff/project/hifi-letter.jsx` lines 6–108
 * (page header + drop-cap opener). DEV-51 lands the page shell:
 * header, salutation, and the hard-coded drop-cap opening paragraph.
 * The rest of the letter body (DEV-53), the right-rail navigator
 * (DEV-52), the signature row (DEV-54), and the share section
 * (DEV-55) are stubbed here as empty `data-stub` divs that later
 * issues replace in place.
 *
 * Layout: a single centred prose column at the prototype's 760px
 * measure. The right rail floats outside the column on desktop
 * (DEV-52); on mobile there's only the prose.
 *
 * Typography notes (issue scope, authoritative over the prototype):
 *   - body prose: 19px / leading 1.6 / -0.01em tracking
 *   - H1: 48px mobile, 88px desktop (above the --text-hero ceiling, so
 *     set explicitly rather than via the token)
 *   - salutation: display 36px bold deep-cyan — the issue overrides the
 *     prototype's 20px body treatment; deep-cyan (#074661) on paper
 *     clears AA comfortably
 *   - drop cap: 96px display deep-cyan, float left, leading 0.85 — float
 *     not CSS `initial-letter`, which is still Safari-only and prefixed
 */

import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import Kicker from "~/components/Kicker.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getLetter, getVoiceCount } from "~/lib/content";
import { LETTER_COPY, letterHeadline } from "~/lib/letter";

const count = getVoiceCount();
const letter = getLetter("en");
const { salutation } = letter.frontmatter;
const headline = letterHeadline(count);
---

<BaseLayout title="The Letter" ogImage="/og/letter.png">
	<Header slot="header" active="letter" count={count} sticky />

	{/* Right-rail navigator — replaced by DEV-52 (desktop-only scroll spy). */}
	<div data-stub="letter-rail"></div>

	<article
		class:list={[
			"font-body text-ink mx-auto max-w-[760px]",
			"px-6 pt-14 pb-20",
			"text-[19px] leading-[1.6] tracking-[-0.01em]",
		]}
	>
		<header class="border-ink flex flex-col gap-4 border-b-2 pb-7">
			<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
				<Kicker>{LETTER_COPY.kicker}</Kicker>
				<time class="font-body text-ink-3 text-caption" datetime={LETTER_COPY.dateISO}>
					{LETTER_COPY.date}
				</time>
			</div>

			<h1 class="font-display lg:text-answer text-[48px] leading-none font-bold tracking-[-0.02em]">
				{headline}
			</h1>

			<p
				class="font-display text-ink-2 max-w-[42ch] text-[18px] leading-[1.3] font-medium lg:text-[22px]"
			>
				{LETTER_COPY.subtitle}
			</p>
		</header>

		{/* Salutation — display 36px bold deep-cyan per the issue. */}
		<p class="font-display text-deep-cyan mt-11 mb-9 text-[36px] leading-tight font-bold">
			{salutation}
		</p>

		{
			/* Opening paragraph with drop cap. Hard-coded for DEV-51; DEV-53
		   generalises the `::dropcap` directive across the whole body.
		   The cap is the first letter only — the rest of the word flows
		   from the adjacent text node, so a screen reader still reads
		   "We are writing…" as one phrase (no aria-hidden on the cap). */
		}
		<p class="m-0">
			<span
				class="font-display text-dropcap text-deep-cyan float-left mt-1.5 mr-3 -mb-1 leading-[0.85] font-bold tracking-[-0.02em]"
				>W</span
			>e are writing to you as young people who love football.
		</p>

		{/* Rest of the letter body — replaced by DEV-53 (directive renderer). */}
		<div data-stub="letter-body"></div>

		{/* Signature row — replaced by DEV-54. */}
		<div data-stub="signatures"></div>

		{/* Share section — replaced by DEV-55. */}
		<div data-stub="share"></div>
	</article>

	<Footer slot="footer" count={count} lang="en" />
</BaseLayout>

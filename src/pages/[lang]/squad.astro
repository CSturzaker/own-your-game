---
/**
 * `/{lang}/squad` — localised full-squad pages. One static route per
 * non-default locale; the shared body reads `Astro.currentLocale`
 * (DEV-69).
 */

import Squad from "~/components/pages/Squad.astro";
import { NON_DEFAULT_LOCALES } from "~/i18n/config";

export function getStaticPaths() {
	return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Squad />

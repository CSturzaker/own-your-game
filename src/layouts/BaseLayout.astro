---
import "~/styles/global.css";

interface Props {
	title?: string;
	lang?: string;
}

const { title = "Own Your Game", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<!--
			Google Fonts: Space Grotesk (display), Noto Sans + Noto Sans Display
			(body, with italic display weights for the appendix), JetBrains Mono
			(code in the appendix only). Single weight-bundled stylesheet to
			minimise round-trips; preconnect to fonts.googleapis.com and the
			font CDN (fonts.gstatic.com) per the hi-fi prototype.
		-->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink font-body">
		<slot />
	</body>
</html>

---
import "~/styles/global.css";

import { isRtl } from "~/i18n/config";
import { makeT } from "~/i18n/astro";
import { buildPlayerStrings } from "~/i18n/player-strings";
import { PlayerCardOverlay } from "~/islands/PlayerCardOverlay";
import { getAllVoices } from "~/lib/content";
import { resolveOgImage } from "~/lib/seo";

const { t, locale } = makeT(Astro.currentLocale);

export interface Props {
	/** Page title — rendered as `{title} · Own Your Game` by default. */
	title: string;
	/** Meta description; defaults to the campaign tagline. */
	description?: string;
	/**
	 * HTML `lang` attribute. Defaults to `Astro.currentLocale` so every
	 * page reflects its route's locale automatically; pass an explicit
	 * value only to override (rare). `dir` is derived from it (`rtl` for
	 * Arabic, `ltr` otherwise) — see below.
	 */
	lang?: string;
	/**
	 * Open Graph image URL. Accepts an absolute URL or a root-relative
	 * path; absolute URLs are emitted untouched, relative paths are
	 * upgraded against `Astro.site` for crawler compatibility.
	 */
	ogImage?: string;
	/** Emit `<meta name="robots" content="noindex">` — set on `/demo/*`. */
	noIndex?: boolean;
	/**
	 * Append ` · Own Your Game` to the rendered `<title>`. Defaults to
	 * `true`. The home page passes `false` so its tab title reads
	 * "Own Your Game" alone rather than "Own Your Game · Own Your Game".
	 */
	titleSuffix?: boolean;
}

const {
	title,
	description = t("meta.description"),
	lang = locale,
	ogImage,
	noIndex = false,
	titleSuffix = true,
} = Astro.props;

const fullTitle = titleSuffix ? `${title} · Own Your Game` : title;
const ogImageUrl = resolveOgImage(ogImage, Astro.site);

// Voice data + strings for the player card overlay (DEV-43). Mounted
// once here so a tile click on any page opens the card as a modal in
// place; dormant (renders nothing) until then. `client:idle` keeps the
// hydration out of the cold-load TBT window — a tile clicked before
// hydration falls through to a normal navigation to the standalone
// `/voice/{id}` page, which renders the same content.
const overlayVoices = getAllVoices();
const playerStrings = buildPlayerStrings(t);
// Arabic reads right-to-left; every other locale is LTR. `dir` on <html>
// cascades to the whole tree so Tailwind's logical utilities (ps-/pe-/
// ms-/me-/start-/end-) and the `rtl:` variant flip automatically.
const dir = isRtl(lang) ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{noIndex && <meta name="robots" content="noindex" />}

		<title>{fullTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content={lang} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!--
			Google Fonts — Space Grotesk (display), Noto Sans + Noto Sans
			Display (body + italic display weights for the appendix),
			JetBrains Mono (code in the appendix only). Single weight-
			bundled stylesheet copied verbatim from the hi-fi prototype
			head so dev and prod loads match the design fidelity work.
		-->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-paper text-ink font-body min-h-screen antialiased">
		<a
			href="#main"
			class="focus:bg-ink focus:text-paper focus:rounded-card sr-only focus:not-sr-only focus:absolute focus:inset-s-2 focus:top-2 focus:z-50 focus:px-4 focus:py-2"
		>
			{t("common.skipToContent")}
		</a>
		<slot name="header" />
		{
			/*
			tabindex="-1" so activating the skip link actually moves
			focus into <main> rather than only scrolling to it — without
			it most browsers leave focus on the skip link, which defeats
			the purpose for keyboard + screen-reader users.
		*/
		}
		<main id="main" tabindex="-1" class="focus:outline-none">
			<slot />
		</main>
		<slot name="footer" />
		<PlayerCardOverlay client:idle voices={overlayVoices} strings={playerStrings} locale={locale} />
	</body>
</html>

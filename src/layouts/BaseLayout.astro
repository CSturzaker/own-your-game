---
import "~/styles/global.css";
// The above-the-fold display face — preload the Latin subset so the hero
// counter + headings paint without a swap (DEV-75). Vite emits the hashed
// asset URL from this `?url` import; @font-face for it lives in global.css.
import spaceGroteskLatin from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
// Arabic face — loaded only on RTL pages (see the `<style>` below). Kept
// out of global.css so the footer switcher's Arabic endonym doesn't pull
// this file onto every Latin page.
import notoSansArabic from "@fontsource-variable/noto-sans-arabic/files/noto-sans-arabic-arabic-wght-normal.woff2?url";

import { isRtl } from "~/i18n/config";
import { makeT } from "~/i18n/astro";
import { buildPlayerStrings } from "~/i18n/player-strings";
import { PlayerCardOverlay } from "~/islands/PlayerCardOverlay";
import { BEACON_SRC, beaconConfig } from "~/lib/analytics";
import {
	ogLocale,
	ogLocaleAlternates,
	resolveCanonical,
	resolveOgImage,
	SITE_NAME,
	TWITTER_SITE,
} from "~/lib/seo";

const { t, locale } = makeT(Astro.currentLocale);

export interface Props {
	/** Page title — rendered as `{title} · Own Your Game` by default. */
	title: string;
	/** Meta description; defaults to the campaign tagline. */
	description?: string;
	/**
	 * HTML `lang` attribute. Defaults to `Astro.currentLocale` so every
	 * page reflects its route's locale automatically; pass an explicit
	 * value only to override (rare). `dir` is derived from it (`rtl` for
	 * Arabic, `ltr` otherwise) — see below.
	 */
	lang?: string;
	/**
	 * Open Graph image URL. Accepts an absolute URL or a root-relative
	 * path; absolute URLs are emitted untouched, relative paths are
	 * upgraded against `Astro.site` for crawler compatibility.
	 */
	ogImage?: string;
	/** Emit `<meta name="robots" content="noindex">` — set on `/demo/*`. */
	noIndex?: boolean;
	/**
	 * Append ` · Own Your Game` to the rendered `<title>`. Defaults to
	 * `true`. The home page passes `false` so its tab title reads
	 * "Own Your Game" alone rather than "Own Your Game · Own Your Game".
	 */
	titleSuffix?: boolean;
}

const {
	title,
	description = t("meta.description"),
	lang = locale,
	ogImage,
	noIndex = false,
	titleSuffix = true,
} = Astro.props;

const fullTitle = titleSuffix ? `${title} · Own Your Game` : title;
const ogImageUrl = resolveOgImage(ogImage, Astro.site);
// Canonical / og:url — origin-qualified, query + hash stripped (so the
// squad's filtered URLs and the letter's #anchors don't fork the
// canonical). Requires `site` (set in astro.config.mjs).
const canonicalUrl = resolveCanonical(Astro.url, Astro.site);

// Strings for the player card overlay (DEV-43). Mounted once here so a
// tile click on any page opens the card as a modal in place; dormant
// (renders nothing) until then. `client:idle` keeps the hydration out of
// the cold-load TBT window — a tile clicked before hydration falls through
// to a normal navigation to the standalone `/voice/{id}` page, which
// renders the same content. The overlay no longer carries the voice set:
// it fetches the lightweight index and per-voice data on demand (DEV-107),
// so no page inlines the catalogue.
const playerStrings = buildPlayerStrings(t);
// Arabic reads right-to-left; every other locale is LTR. `dir` on <html>
// cascades to the whole tree so Tailwind's logical utilities (ps-/pe-/
// ms-/me-/start-/end-) and the `rtl:` variant flip automatically.
const dir = isRtl(lang) ? "rtl" : "ltr";
const rtl = isRtl(lang);

// Cloudflare Web Analytics (DEV-125) — cookie-less, aggregate-only. The
// explicit snippet (not dashboard auto-injection, which isn't
// version-controlled) is emitted only when PUBLIC_CF_BEACON_TOKEN is set,
// which happens only in the production deploy env — preview/CI/local
// builds carry no beacon, keeping their traffic out of the data.
const beaconJson = beaconConfig();

// Noto Sans Arabic @font-face — emitted inline only on RTL pages (DEV-75),
// so the Arabic file never loads on Latin pages. The unicode-range mirrors
// @fontsource's Arabic subset, so the file still fetches lazily (when
// Arabic glyphs paint) rather than on parse.
//
// `font-display: optional`, not `swap` (DEV-128): a late-arriving swap
// reflowed every RTL page (~30–56px, RUM-attributed to the footer), and
// Arabic line-wrap parity can't be tuned away with size-adjust the way
// DEV-105 did for the Latin faces — the bold display headings need >137%
// against Arial while body prose needs ~112%, so any single value still
// re-wraps something. `optional` makes the late shift structurally
// impossible: with the preload below, fast and repeat visits paint Noto
// from the first frame; a slow first visit keeps the metric-matched
// fallback face (global.css, DEV-128) for the whole session instead of
// reflowing mid-read.
const arabicFontFace = `@font-face{font-family:"Noto Sans Arabic Variable";font-style:normal;font-display:optional;font-weight:100 900;src:url(${notoSansArabic}) format("woff2");unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0897-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC,U+102E0-102FB,U+10E60-10E7E,U+10EC2-10EC4,U+10EFC-10EFF,U+1EE00-1EE03,U+1EE05-1EE1F,U+1EE21-1EE22,U+1EE24,U+1EE27,U+1EE29-1EE32,U+1EE34-1EE37,U+1EE39,U+1EE3B,U+1EE42,U+1EE47,U+1EE49,U+1EE4B,U+1EE4D-1EE4F,U+1EE51-1EE52,U+1EE54,U+1EE57,U+1EE59,U+1EE5B,U+1EE5D,U+1EE5F,U+1EE61-1EE62,U+1EE64,U+1EE67-1EE6A,U+1EE6C-1EE72,U+1EE74-1EE77,U+1EE79-1EE7C,U+1EE7E,U+1EE80-1EE89,U+1EE8B-1EE9B,U+1EEA1-1EEA3,U+1EEA5-1EEA9,U+1EEAB-1EEBB,U+1EEF0-1EEF1;}`;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{noIndex && <meta name="robots" content="noindex" />}

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content={ogLocale(locale)} />
		{ogLocaleAlternates(locale).map((alt) => <meta property="og:locale:alternate" content={alt} />)}

		<meta name="twitter:card" content="summary_large_image" />
		{TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png" />
		<link rel="manifest" href="/site.webmanifest" />

		{beaconJson && <script is:inline defer src={BEACON_SRC} data-cf-beacon={beaconJson} />}

		<!--
			Fonts are self-hosted and subset via @fontsource-variable
			(DEV-75) — the @font-face rules ship in the bundled CSS from
			global.css, so there is no external font request. We preload
			only the above-the-fold display Latin subset; every other
			range/family is fetched on demand via its `unicode-range`.
		-->
		<link
			rel="preload"
			href={spaceGroteskLatin}
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		{
			rtl && (
				<>
					<link
						rel="preload"
						href={notoSansArabic}
						as="font"
						type="font/woff2"
						crossorigin="anonymous"
					/>
					<style is:inline set:html={arabicFontFace} />
				</>
			)
		}
	</head>
	<body class="bg-paper text-ink font-body min-h-screen antialiased">
		<a
			href="#main"
			class="focus:bg-ink focus:text-paper focus:rounded-card sr-only focus:not-sr-only focus:absolute focus:inset-s-2 focus:top-2 focus:z-50 focus:px-4 focus:py-2"
		>
			{t("common.skipToContent")}
		</a>
		<slot name="header" />
		{
			/*
			tabindex="-1" so activating the skip link actually moves
			focus into <main> rather than only scrolling to it — without
			it most browsers leave focus on the skip link, which defeats
			the purpose for keyboard + screen-reader users.
		*/
		}
		<main id="main" tabindex="-1" class="focus:outline-none">
			<slot />
		</main>
		<slot name="footer" />
		<PlayerCardOverlay client:idle strings={playerStrings} locale={locale} />
	</body>
</html>
